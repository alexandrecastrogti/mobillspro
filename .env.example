# ========================================================
# MobillsPro - Environment Variables Configuration
# Alexandre & Amanda - Muriaé/MG
# ========================================================

# Servidor Backend
PORT=3001
NODE_ENV=development

# Banco de Dados PostgreSQL (Prisma)
# Para deploy na nuvem: Supabase, Neon, Render, Railway, Fly.io ou Docker
DATABASE_URL=postgresql://mobills:mobillspassword2026@localhost:5432/mobillspro?schema=public

# Autenticação JWT (Tokens de Acesso e Refresh)
JWT_SECRET=sua_chave_jwt_super_secreta_mobillspro_2026
JWT_REFRESH_SECRET=sua_chave_refresh_super_secreta_mobillspro_2026

# Inteligência Artificial com Google Gemini
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_api_aqui
GEMINI_MODEL=gemini-1.5-flash
