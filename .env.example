# MobillsPro Configuration

# Porta do servidor (Padrão: 3001)
PORT=3001

# Modo de execução
NODE_ENV=production

# Conexão com banco PostgreSQL na nuvem (Supabase, Neon, Render, Railway, AWS RDS)
# Se não preenchido, o MobillsPro utiliza automaticamente o motor de persistência
# local JSON estruturado (server/data/mobillspro.json) mantendo 100% de disponibilidade.
DATABASE_URL=postgresql://postgres:sua_senha@seu_host.supabase.co:5432/postgres

